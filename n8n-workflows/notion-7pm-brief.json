    {
      "parameters": {
        "jsCode": "// [순서 매핑 확인]\n// Input 1 (Index 0): ✅ 완료된 일\n// Input 2 (Index 1): 🔥 미완료된 일 (오늘 할 일인데 안 한 거)\n// Input 3 (Index 2): ⚠️ 변경된 일\n// Input 4 (Index 3): 🚀 내일 할 일\n\nconst items = $input.all();\n\n// 각 인덱스별로 결과가 없어도 빈 배열([])을 할당하여 에러 방지\nconst completedTasks = items[0]?.json?.results || [];\nconst uncompletedTasks = items[1]?.json?.results || [];\nconst changedTasks = items[2]?.json?.results || [];\nconst tomorrowTasks = items[3]?.json?.results || [];\n\nconst today = new Date().toISOString().split('T')[0];\n\n// ----------------------------------------\n// 🎨 디스코드 리포트 작성 (순서 교체 버전)\n// ----------------------------------------\n\nlet report = `# 📅 데일리 리포트 (${today})\\n`;\nreport += `─────────────────────\\n\\n`;\n\n// 1. ✅ 오늘 완료된 할 일\nreport += `### ✅ 오늘 완료된 할 일 (${completedTasks.length}개)\\n`;\nif (completedTasks.length > 0) {\n  completedTasks.forEach(task => {\n    const title = task.properties['이름']?.title[0]?.plain_text || '제목 없음';\n    const url = task.url;\n    report += `> • [${title}](${url})\\n`;\n  });\n} else {\n  report += \"> 💤 완료된 할 일이 없습니다.\\n\";\n}\nreport += '\\n';\n\n// 2. 🔥 오늘 못다 한 일 (미완료)\nreport += `### 🔥 오늘 못다 한 일 (${uncompletedTasks.length}개)\\n`;\nif (uncompletedTasks.length > 0) {\n  uncompletedTasks.forEach(task => {\n    const title = task.properties['이름']?.title[0]?.plain_text || '제목 없음';\n    const url = task.url;\n    report += `> • [${title}](${url})\\n`;\n  });\n} else {\n  report += \"> 💯 완벽해요! 오늘의 할 일을 모두 마쳤습니다.\\n\";\n}\nreport += '\\n';\n\n// 3. ⚠️ 날짜가 변경된 일 (순서 이동)\nreport += `### ⚠️ 날짜가 변경된 일 (${changedTasks.length}개)\\n`;\nif (changedTasks.length > 0) {\n  changedTasks.forEach(task => {\n    const title = task.properties['이름']?.title[0]?.plain_text || '제목 없음';\n    const url = task.url;\n    const date = task.properties['날짜']?.date?.start || '미정';\n    report += `> • [${title}](${url}) (🗓️ -> ${date})\\n`;\n  });\n} else {\n  report += \"> ✨ 일정 변경 없음\\n\";\n}\nreport += '\\n';\n\n// 4. 🚀 내일 할 일 (순서 이동)\nreport += `### 🚀 내일 할 일 (${tomorrowTasks.length}개)\\n`;\nif (tomorrowTasks.length > 0) {\n  tomorrowTasks.forEach(task => {\n    const title = task.properties['이름']?.title[0]?.plain_text || '제목 없음';\n    const url = task.url;\n    const tags = task.properties['다음 행동 상황']?.multi_select?.map(t => t.name).join(', ') || '';\n    \n    report += `> • [${title}](${url})`;\n    if (tags) report += ` \\`[${tags}]\\``;\n    report += '\\n';\n  });\n} else {\n  report += \"> 🏖️ 내일 예정된 할 일이 없습니다.\\n\";\n}\n\nreport += `\\n─────────────────────`;\n\nreturn { json: { report: report } };"
      },
