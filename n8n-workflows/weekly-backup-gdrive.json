{
  "name": "Weekly n8n Backup to Google Drive",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1,
              "triggerAtDay": [0],
              "triggerAtHour": 3,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Weekly Schedule (Sunday 3AM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.WEBHOOK_URL }}/rest/workflows",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "options": {}
      },
      "id": "get-workflows",
      "name": "Get All Workflows",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300],
      "credentials": {
        "httpBasicAuth": {
          "id": "n8n-basic-auth",
          "name": "n8n Basic Auth"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.WEBHOOK_URL }}/rest/credentials",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "options": {}
      },
      "id": "get-credentials-list",
      "name": "Get Credentials List",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 500],
      "credentials": {
        "httpBasicAuth": {
          "id": "n8n-basic-auth",
          "name": "n8n Basic Auth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const workflows = $('Get All Workflows').first().json.data || [];\nconst credentialsList = $('Get Credentials List').first().json.data || [];\n\nconst timestamp = new Date().toISOString().split('T')[0];\nconst backupData = {\n  backupDate: new Date().toISOString(),\n  n8nVersion: $env.N8N_VERSION || 'unknown',\n  workflows: workflows,\n  credentialsCount: credentialsList.length,\n  credentialNames: credentialsList.map(c => ({ id: c.id, name: c.name, type: c.type }))\n};\n\nreturn [{\n  json: {\n    filename: `n8n-backup-${timestamp}.json`,\n    content: JSON.stringify(backupData, null, 2),\n    mimeType: 'application/json'\n  }\n}];"
      },
      "id": "prepare-backup",
      "name": "Prepare Backup Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 400]
    },
    {
      "parameters": {
        "operation": "upload",
        "name": "={{ $json.filename }}",
        "folderId": {
          "__rl": true,
          "value": "n8n-backups",
          "mode": "name"
        },
        "options": {
          "mimeType": "={{ $json.mimeType }}"
        }
      },
      "id": "upload-gdrive",
      "name": "Upload to Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [900, 400],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "google-drive-oauth",
          "name": "Google Drive OAuth2"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-upload",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-success",
      "name": "Check Upload Success",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1100, 400]
    },
    {
      "parameters": {
        "jsCode": "const uploadResult = $('Upload to Google Drive').first().json;\nconst backupInfo = $('Prepare Backup Data').first().json;\n\nreturn [{\n  json: {\n    status: 'SUCCESS',\n    message: `Backup completed: ${backupInfo.filename}`,\n    fileId: uploadResult.id,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "success-log",
      "name": "Log Success",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1300, 300]
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    status: 'FAILED',\n    message: 'Backup upload failed',\n    timestamp: new Date().toISOString(),\n    error: $json\n  }\n}];"
      },
      "id": "failure-log",
      "name": "Log Failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1300, 500]
    }
  ],
  "connections": {
    "Weekly Schedule (Sunday 3AM)": {
      "main": [
        [
          { "node": "Get All Workflows", "type": "main", "index": 0 },
          { "node": "Get Credentials List", "type": "main", "index": 0 }
        ]
      ]
    },
    "Get All Workflows": {
      "main": [
        [{ "node": "Prepare Backup Data", "type": "main", "index": 0 }]
      ]
    },
    "Get Credentials List": {
      "main": [
        [{ "node": "Prepare Backup Data", "type": "main", "index": 0 }]
      ]
    },
    "Prepare Backup Data": {
      "main": [
        [{ "node": "Upload to Google Drive", "type": "main", "index": 0 }]
      ]
    },
    "Upload to Google Drive": {
      "main": [
        [{ "node": "Check Upload Success", "type": "main", "index": 0 }]
      ]
    },
    "Check Upload Success": {
      "main": [
        [{ "node": "Log Success", "type": "main", "index": 0 }],
        [{ "node": "Log Failure", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": ["backup", "automation", "maintenance"]
}
