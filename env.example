# ============================================
# n8n Railway 환경변수 설정
# 복사하여 Railway Variables에 입력하세요
# ============================================

# ============ 필수 설정 ============

# 도메인 설정 (Cloudflare 연동)
N8N_HOST=n8n.ryunae.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.ryunae.com/

# 암호화 키 (반드시 변경! - openssl rand -hex 32 로 생성)
N8N_ENCRYPTION_KEY=여기에_32바이트_헥스_문자열_입력

# 기본 인증 설정
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=강력한_비밀번호_입력

# ============ PostgreSQL 데이터베이스 ============
# Railway PostgreSQL 추가 시 자동 생성되는 변수 사용
# ${{Postgres.DATABASE_URL}} 형식으로 Railway에서 연결

DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=${{Postgres.PGHOST}}
DB_POSTGRESDB_PORT=${{Postgres.PGPORT}}
DB_POSTGRESDB_DATABASE=${{Postgres.PGDATABASE}}
DB_POSTGRESDB_USER=${{Postgres.PGUSER}}
DB_POSTGRESDB_PASSWORD=${{Postgres.PGPASSWORD}}

# ============ 타임존 ============
GENERIC_TIMEZONE=Asia/Seoul
TZ=Asia/Seoul

# ============ Google OAuth 설정 ============
# Google Cloud Console에서 생성
# 리다이렉트 URI: https://n8n.ryunae.com/rest/oauth2-credential/callback

GOOGLE_CLIENT_ID=여기에_구글_클라이언트_ID
GOOGLE_CLIENT_SECRET=여기에_구글_클라이언트_시크릿

# ============ AI API Keys ============

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-여기에_API_키

# OpenAI (ChatGPT)
OPENAI_API_KEY=sk-여기에_API_키

# Google AI (Gemini)
GOOGLE_AI_API_KEY=여기에_Gemini_API_키

# ============ Notion API ============
NOTION_API_KEY=secret_여기에_노션_API_키

# ============ 실행 설정 ============
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_ON_PROGRESS=false
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true

# 실행 기록 보관 (7일 = 168시간)
EXECUTIONS_DATA_MAX_AGE=168

# ============ 보안 설정 ============
N8N_SECURE_COOKIE=true
N8N_PERSONALIZATION_ENABLED=false

# ============ 로그 설정 ============
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console
